# Alpine-Contributor: Justin Berthault <justin.berthault@zaclys.net>
# Alpine-Maintainer: Will Sinatra <wpsinatra@gmail.com>
# Maintainer: Elliott Mazzuca <emazzuca@qnx.com>
pkgname=python3-iniconfig
_pyname=iniconfig
pkgver=2.3.0
pkgrel=0
pkgdesc="brain-dead simple config-ini parsing"
url="https://github.com/pytest-dev/iniconfig"
arch="noarch"
license="MIT"
makedepends="
    python3-gpep517
    python3-setuptools
    python3-wheel
    python3-py
    python3-hatch-vcs
    python3-hatchling
    "
options="!check" # avoid circular dependencies
checkdepends="python3-pytest python3-pytest-xdist"
source="https://files.pythonhosted.org/packages/source/i/$_pyname/$_pyname-$pkgver.tar.gz
    "
builddir="$srcdir/$_pyname-$pkgver"

build() {
    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2
}

check() {
    python3 -m venv --clear --without-pip --system-site-packages .testenv
    .testenv/bin/python3 -m installer .dist/*.whl
    .testenv/bin/python3 -m pytest
}

package() {
    python3 -m installer -d "$pkgdir" \
        .dist/*.whl
}

sha512sums="
65f9200c904fae6d4691823a8c1c7af7d80d91438db47a6fa84a7688d0b95c73b65702a9ada16383a6c2036438b657b9981d2fcffbe6bbb5ed744b54557094eb  iniconfig-2.3.0.tar.gz
"
